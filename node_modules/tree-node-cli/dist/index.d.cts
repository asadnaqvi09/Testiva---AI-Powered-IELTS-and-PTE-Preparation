//#region src/formats/json.d.ts
interface TreeJsonEntryBase {
  name: string;
  size?: number;
  mode?: string;
  time?: string;
  error?: string;
}
interface TreeJsonDirectoryEntry extends TreeJsonEntryBase {
  type: 'directory';
  contents: TreeJsonEntry[];
}
interface TreeJsonFileEntry extends TreeJsonEntryBase {
  type: 'file';
}
type TreeJsonEntry = TreeJsonDirectoryEntry | TreeJsonFileEntry;
//#endregion
//#region src/index.d.ts
type SortBy = 'name' | 'version' | 'mtime' | 'ctime' | 'size';
interface Options {
  allFiles?: boolean;
  date?: boolean;
  dirsFirst?: boolean;
  dirsOnly?: boolean;
  du?: boolean;
  filesFirst?: boolean;
  humanReadable?: boolean;
  fullPath?: boolean;
  noIndent?: boolean;
  permissions?: boolean;
  prune?: boolean;
  quote?: boolean;
  sizes?: boolean;
  si?: boolean;
  exclude?: RegExp[];
  maxDepth?: number;
  reverse?: boolean;
  sortBy?: SortBy;
  trailingSlash?: boolean;
  lineAscii?: boolean;
  gitignore?: boolean;
  unsorted?: boolean;
}
type RequiredOptions = Required<Options>;
interface TreeNode {
  name: string;
  path: string;
  isDirectory: boolean;
  mode: number;
  mtime: Date;
  size: number;
  children: TreeNode[];
  openError?: boolean;
}
/** Returns the directory tree as a formatted string. */
declare function tree(path: string, options?: Options): string;
/**
 * Returns the directory tree as a structured JSON entry, or `null` if the root is excluded.
 */
declare function treeJson(path: string, options?: Options): TreeJsonEntry | null;
//#endregion
export { Options, RequiredOptions, SortBy, TreeNode, tree, treeJson };