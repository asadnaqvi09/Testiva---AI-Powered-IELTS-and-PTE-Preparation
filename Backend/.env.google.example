# Google Sign-In — must match Flutter GoogleAuthService.serverClientId
# (Web OAuth client / client_type 3 in google-services.json)
GOOGLE_CLIENT_ID=298829936456-ftno9o41s987ca986oek9hrmjst0odfo.apps.googleusercontent.com

# Optional: also accept Android OAuth client as token audience
GOOGLE_ANDROID_CLIENT_ID=298829936456-8tquaegaoag315ot820m4529241qct3e.apps.googleusercontent.com

# FCM Admin SDK — path to Firebase service account JSON (gitignored).
# Without this file, in-app Socket notifications still work; native push is skipped.
# Place the file at Backend/src/config/firebase-adminsdk.json
GOOGLE_APPLICATION_CREDENTIALS=./src/config/firebase-adminsdk.json
